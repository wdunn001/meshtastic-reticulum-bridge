# Copy to .env and fill in. The only required value is TARGET_LXMF_HASH.

# REQUIRED: the LXMF delivery destination that should receive Meshtastic messages
# (32 hex chars). This is the address of whatever you want to read them in --
# e.g. a Sideband/NomadNet identity, or a MeshChat/comms app.
TARGET_LXMF_HASH=

# OPTIONAL: an LXMF propagation node hash for store-and-forward delivery when the
# target isn't directly reachable. Leave blank to send direct only.
PROPAGATION_NODE_HASH=

# OPTIONAL display + status HTTP port
DISPLAY_NAME=Meshtastic Bridge
LISTEN_PORT=8212

# MQTT -- defaults match the bundled Mosquitto (anonymous, topic root "msh").
# Point your Meshtastic node's MQTT server at THIS_HOST:1883, topic prefix "msh",
# and enable BOTH uplink and downlink. If you use an external/authenticated broker
# instead, set these to match it (and MQTT_TOPIC_ROOT to whatever your node uses).
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_ROOT=msh

# DOWNLINK (Reticulum -> Meshtastic) -- ON by default. Inbound LXMF sent to the
# bridge's own address is re-encrypted and published to the channel's MQTT topic;
# a gateway node with "Downlink enabled" on that channel then rebroadcasts it to
# LoRa. For the DEFAULT channel, the key/hash/topic are auto-learned from uplink
# traffic, so nothing else is needed. Set ENABLE_DOWNLINK=false for uplink-only.
ENABLE_DOWNLINK=true
DOWNLINK_CHANNEL=LongFast
# For a CUSTOM-PSK channel, set the 32-hex-char AES-128 key here (and, if the
# bridge won't see uplink traffic on it first, DOWNLINK_TOPIC_PREFIX below).
DOWNLINK_PSK=
# DOWNLINK_TOPIC_PREFIX=msh/US/2/e/LongFast
# DOWNLINK_CHANNEL_HASH=
# DOWNLINK_HOP_LIMIT=3
# DOWNLINK_MAX_BYTES=200
# BRIDGE_NODE_NUM=
